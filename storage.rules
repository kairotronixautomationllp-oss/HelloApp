rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat_images/{chatId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid in
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
      allow write: if request.auth != null && request.auth.uid in
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
