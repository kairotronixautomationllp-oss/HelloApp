rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /users/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.phone == request.auth.token.get('phone_number', null)
        && request.resource.data.email == request.auth.token.get('email', null);
      allow read: if signedIn(); // MVP lookup; tighten with invitations / discovery service before launch
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow read, delete: if member(chatId);
      allow update: if member(chatId) && request.resource.data.members == resource.data.members;
      match /messages/{messageId} {
        allow read: if member(chatId);
        allow create: if member(chatId) && request.resource.data.sender == request.auth.uid;
      }
    }
  }
}
